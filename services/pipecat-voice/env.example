# URL pública de Noova (API bridge-config / finalize)
NOOVA_APP_URL=http://localhost:8000

# Secreto compartido con Noova (mismo valor en .env.local)
PIPECAT_INTERNAL_SECRET=

# Google Gemini Live — OPCIONAL desde que la app Noova propaga google_api_key en bridge-config.
# Si la recibes desde Noova (bridge-config), no es necesario configurarla aquí.
# Si prefieres una key dedicada (recomendado en producción para cuotas separadas), ponla aquí.
GOOGLE_API_KEY=
GOOGLE_AI_KEY=

# Telnyx (Call Control — usado por TelnyxFrameSerializer)
TELNYX_API_KEY=

# Puerto del servicio Pipecat
PORT=8765
