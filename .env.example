# Supabase (ya configurado)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI — voz (Gemini Live)
NEXT_PUBLIC_GOOGLE_AI_KEY=

# Telefonía — Twilio (MVP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL pública de la app (webhooks).
# Local: http://localhost:8000  |  Producción (Coolify): https://app.noova360.com
# URL pública HTTPS — webhooks Telnyx
NOOVA_APP_URL=http://localhost:8000
# Micrositio de chat (ruta corta /c). Si LINK_BASE_URL es solo el dominio, se añade /c automáticamente.
# NEXT_PUBLIC_LINK_BASE_URL=https://app.noova360.com/c
# NEXT_PUBLIC_MICROSITE_PATH=/c
# NEXT_PUBLIC_APP_URL=https://app.noova360.com
TELEPHONY_PROVIDER=telnyx

# Pipecat self-hosted — WebSocket de media Telnyx (wss://…/ws)
# Si está definido, reemplaza el bridge DIY de server.ts
PIPECAT_WS_URL=ws://localhost:8765/ws
# Secreto compartido entre Noova y el servicio Pipecat
PIPECAT_INTERNAL_SECRET=

# Telnyx — https://portal.telnyx.com → API Keys → Create Key
TELNYX_API_KEY=
# Call Control Application ID (Voice → Call Control → Noova Production)
TELNYX_CONNECTION_ID=
# Outbound Voice Profile ID (opcional — si falta, se usa el primero activo de la cuenta)
TELNYX_OUTBOUND_VOICE_PROFILE_ID=

# Notificaciones admin (solicitudes de línea) — https://resend.com
RESEND_API_KEY=
NOOVA_ADMIN_EMAIL=
RESEND_FROM_EMAIL=Noova <notificaciones@tudominio.com>
