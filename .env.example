# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña Postgres (Dashboard → Settings → Database) — migraciones locales
SUPABASE_DB_PASSWORD=

# URL directa opcional (si la tienes en Supabase → Database → Connection string)
# DATABASE_URL=

# Token personal — scripts de configuración Auth SMTP
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# =============================================================================
# URLs de la aplicación
# =============================================================================
# Local: http://127.0.0.1:8000  |  Producción: https://app.noova360.com
NOOVA_APP_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:8000
# Webhooks Twilio/Meta (producción). Si no se define, usa NOOVA_APP_URL.
# NOOVA_WEBHOOK_BASE_URL=https://app.noova360.com

# Mi Link — ruta corta (default /c)
# NEXT_PUBLIC_MICROSITE_PATH=/c
# Base URL pública del link (si solo es dominio, se añade /c)
# NEXT_PUBLIC_LINK_BASE_URL=https://app.noova360.com/c
# Subdominio link → rewrite a /c/{slug}
# MICROSITE_LINK_HOST=link.noova360.com

# Sitio marketing (landing). Logo/login redirigen aquí; /iaseguros de app redirige a marketing.
# NEXT_PUBLIC_MARKETING_URL=https://noova360.com

# =============================================================================
# Google AI
# =============================================================================
# Agentes de texto y voz (navegador + servidor)
NEXT_PUBLIC_GOOGLE_AI_KEY=

# Ori copiloto — API key separada (facturación propia)
ORI_GOOGLE_AI_KEY=
ORI_GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Widget embebible (marketing / iaseguros en noova360.com)
# =============================================================================
# Slug del widget en broker_web_widgets para demo en la landing
# NEXT_PUBLIC_LANDING_WIDGET_SLUG=noova
# NEXT_PUBLIC_LANDING_WIDGET_COLOR=#5b5bf6
# La landing usa ?preview=1 para widget en borrador

# =============================================================================
# Telefonía
# =============================================================================
TELEPHONY_PROVIDER=telnyx

# Telnyx — https://portal.telnyx.com
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
# Aislamiento de voz en SIP premium (ElevenLabs): inbound = audio de quien contesta
# TELNYX_NOISE_SUPPRESSION=inbound
# TELNYX_NOISE_SUPPRESSION_ENGINE=krisp_viva_tel_lite
# TELNYX_NOISE_SUPPRESSION_ATTENUATION=80
# Desactivar: TELNYX_NOISE_SUPPRESSION=disabled

# Twilio (legacy opcional — WhatsApp Fase 0 + voz PSTN)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Solo desarrollo local si el webhook no valida firma (ngrok URL distinta)
# TWILIO_WHATSAPP_SKIP_SIGNATURE=1

# Meta Embedded Signup — vincular WhatsApp desde Canales
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Proveedor de mensajería: twilio (recomendado — Noova gestiona facturación WA) | meta (solo dev/avanzado)
WHATSAPP_DEFAULT_PROVIDER=twilio
# Secreto app Meta (servidor) — OAuth + firma webhook X-Hub-Signature-256
META_APP_SECRET=
# Token que configuras en Meta → WhatsApp → Configuración → Webhook
META_WEBHOOK_VERIFY_TOKEN=
# Solo dev local si ngrok URL distinta
# META_WEBHOOK_SKIP_SIGNATURE=1
# Partner Solution ID de Twilio (solo si WHATSAPP_DEFAULT_PROVIDER=twilio)
NEXT_PUBLIC_TWILIO_WHATSAPP_SOLUTION_ID=

# Pipecat self-hosted — WebSocket media (prioridad si está definido; si no, bridge en server.ts)
PIPECAT_WS_URL=
PIPECAT_INTERNAL_SECRET=

# ElevenLabs — voz premium (Agents + SIP Telnyx)
ELEVENLABS_API_KEY=
# Fallback legacy — preferir vinculación automática vía Canales (phone_numbers.elevenlabs_phone_number_id)
ELEVENLABS_PHONE_NUMBER_ID=
# SIP plataforma Telnyx ↔ ElevenLabs (una vez; cada línea del cliente se importa por API al asignar en Canales)
# Si TELNYX_API_KEY está configurado, el default de outbound es sip.telnyx.com
ELEVENLABS_SIP_OUTBOUND_ADDRESS=sip.telnyx.com
ELEVENLABS_SIP_TRANSPORT=tcp
ELEVENLABS_SIP_MEDIA_ENCRYPTION=allowed
ELEVENLABS_SIP_USERNAME=
ELEVENLABS_SIP_PASSWORD=
# Opcional: IPs/CIDR Telnyx permitidas para inbound (coma-separado)
# ELEVENLABS_SIP_INBOUND_ALLOWED_ADDRESSES=

# Notas de calendario Colombia para agentes (sin redeploy de código)
# JSON: ["Cierre operativo 14:00","Evento X"]
# o pipe: Cierre operativo 14:00|Evento X
# COLOMBIA_CALENDAR_NOTES=

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=Noova 360 <onboarding@resend.dev>
LANDING_LEAD_NOTIFY_EMAIL=
NOOVA_ADMIN_EMAIL=

# =============================================================================
# Web Push (VAPID) — notificaciones push de la PWA móvil (/m)
# Generar con: npx web-push generate-vapid-keys
# =============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@bgsoluciones.com.co

# =============================================================================
# Cron / jobs internos
# =============================================================================
# Secreto para endpoints /api/cron/* (header x-cron-secret). Superadmin también puede invocarlos.
# CRON_SECRET=
# Marcador de campañas en server.ts (Coolify). Por defecto activo; pon 0 para desactivar.
# CAMPAIGN_DIALER_SCHEDULER=0

# =============================================================================
# Servidor (opcional)
# =============================================================================
# PORT=8000
# HOSTNAME=0.0.0.0
