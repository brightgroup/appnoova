{
  "name": "noova-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_DIST_DIR=.next-dev tsx server.ts",
    "dev:clean": "rm -rf .next-dev && NODE_OPTIONS='--max-old-space-size=4096' NEXT_DIST_DIR=.next-dev tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "db:migrate": "node scripts/apply-all-migrations.mjs",
    "backup:db": "node scripts/backup-supabase.mjs",
    "restore:db": "node scripts/restore-supabase.mjs",
    "restore:storage": "node scripts/restore-storage.mjs",
    "email:test": "node scripts/test-resend-email.mjs",
    "email:configure-supabase": "node scripts/configure-supabase-resend-smtp.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.12.0",
    "@google/genai": "^2.8.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.45.0",
    "bufferutil": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.18.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.14",
    "autoprefixer": "^10.4.16",
    "eslint": "^8",
    "eslint-config-next": "15.2.4",
    "postcss": "^8",
    "postgres": "^3.4.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
